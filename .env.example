# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=*
APP_VERSION=1.0.0

# ── Dictionary provider ─────────────────────────────────────────────────
# Currently supported: free | commercial
DICTIONARY_PROVIDER=free
DICTIONARY_CACHE_TTL=86400000
# Optional Cloudflare Worker proxy used when the host IP is blocked by the upstream API.
# DICTIONARY_PROXY_URL=https://lexicon-dictionary-proxy.dalaverisnicholas.workers.dev
# Wiktionary fallback is called directly so it is not affected by proxy outages.
# WIKTIONARY_BASE_URL=https://en.wiktionary.org

# Only used when DICTIONARY_PROVIDER=commercial
COMMERCIAL_DICTIONARY_LABEL=Oxford Dictionary
COMMERCIAL_DICTIONARY_BASE_URL=
COMMERCIAL_DICTIONARY_API_KEY=

# ── AI sentence provider (leave blank until you add a key) ───────────────
# Supported: openai | anthropic | gemini | ecosystem
# "ecosystem" reuses the Ecosystem backend's Gemini key; AI_API_KEY is then
# the shared LEXICON_AI_TOKEN value, not a Gemini key.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Optional endpoint override (ecosystem defaults to the deployed Ecosystem backend)
AI_BASE_URL=
AI_CACHE_TTL=604800000

# ── Frontend (apps/web/.env.local or build-time env) ─────────────────────
# VITE_API_URL=
